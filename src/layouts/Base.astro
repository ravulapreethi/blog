---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Preethi Ravula — notes on AI, models, and making thinking run." } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <main class="page">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Helvetica, Arial, sans-serif;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
    --ink: #e9e5da;
    --heading: #f5f2e9;
    --muted: #a8a49a;
    --faint: #8b877d;
    --paper: #0e1110;
    --wash: #141715;
    --rule: #2a2d2a;
    --accent: #e0622f;
    --accent-soft: rgba(224, 98, 47, 0.14);
  }

  * { box-sizing: border-box; }

  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .page {
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 2rem 4rem;
  }

  h1, h2, h3 {
    font-family: var(--serif);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--heading);
  }

  section { margin: 4rem 0; }

  a { color: var(--accent); }

  /* Sticky in-page nav */
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    margin: 0 -2rem;
    padding: 0.85rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
  }
  .site-nav .nav-brand { color: var(--ink); white-space: nowrap; }
  .site-nav .nav-brand .sep { color: var(--faint); }
  .site-nav nav { display: flex; gap: 1.25rem; }
  .site-nav nav a {
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .site-nav nav a:hover { color: var(--accent); }

  .kicker {
    font-family: var(--mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin: 0 0 1rem;
  }

  .divider {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 0;
  }

  /* Hero */
  .hero {
    padding-top: 4rem;
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    margin: 0;
  }
  .hero h1 em { color: var(--accent); }
  .hero .hero-note {
    font-size: 0.98rem;
    line-height: 1.75;
    color: var(--ink);
    margin: 0;
    max-width: 24rem;
    justify-self: end;
  }
  .hero-sub {
    margin: 2.5rem 0 0;
    color: var(--ink);
    font-size: 1.05rem;
  }

  /* Preview row */
  .teaser-row {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    gap: 2rem;
    align-items: baseline;
    text-decoration: none;
    color: inherit;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 1.5rem 0;
    margin-top: 3rem;
  }
  .teaser-row .teaser-label {
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .teaser-row .teaser-main strong {
    display: block;
    font-family: var(--serif);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--heading);
    margin-bottom: 0.25rem;
  }
  .teaser-row .teaser-main span { color: var(--muted); }
  .teaser-row .teaser-meta {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--faint);
    text-align: right;
    white-space: nowrap;
  }

  /* Bio */
  .bio {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 3rem;
    align-items: start;
  }
  .bio img {
    width: 220px;
    height: 260px;
    border-radius: 14px;
    object-fit: cover;
    border: 1px solid var(--rule);
  }
  .bio h2 { font-size: 2rem; margin: 0 0 1rem; }
  .bio h2 .name-link {
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    margin-left: 0.75rem;
    vertical-align: middle;
    white-space: nowrap;
  }
  .bio h2 .name-link:hover { text-decoration: underline; }
  .bio .bio-line1 { margin: 0 0 1rem; font-size: 1.1rem; color: var(--heading); }
  .bio .bio-line2 { margin: 0 0 1.25rem; color: var(--muted); }
  .bio .bio-edu {
    margin: 0;
    font-style: italic;
    font-size: 0.92rem;
    color: var(--faint);
    line-height: 1.8;
  }

  /* Notes */
  .note-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 3rem;
  }
  .coming-soon {
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    display: block;
    margin-bottom: 0.75rem;
  }
  .tag-label {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--faint);
    margin: 0;
  }
  .post-title { font-size: clamp(2.2rem, 4.5vw, 3.2rem); margin: 0 0 0.5rem; }
  .post-subtitle {
    font-family: var(--serif);
    font-size: 1.25rem;
    color: var(--muted);
    margin: 0 0 2rem;
  }
  .post-body { max-width: 44rem; }
  .post-body p { margin: 0 0 1.25rem; }
  .coming-next {
    border-top: 2px solid var(--accent);
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    max-width: 44rem;
  }
  .coming-next p {
    font-family: var(--serif);
    font-size: 1.4rem;
    margin: 0;
    color: var(--heading);
  }
  .discuss-link { margin-top: 1.5rem; }
  .back-link {
    display: inline-block;
    color: var(--accent);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .back-link:hover { text-decoration: underline; }

  /* Method */
  .method-lines .method-sub { color: var(--muted); margin: 1rem 0 0; max-width: 36rem; }
  .method-lines h2 { font-size: clamp(1.7rem, 3.2vw, 2.6rem); margin: 0; max-width: 20ch; }

  /* Topics */
  .topics-title { font-size: clamp(1.7rem, 3.2vw, 2.6rem); margin: 0 0 1rem; }
  .topics-intro { color: var(--muted); max-width: 44rem; margin: 0 0 2.5rem; }
  .topics-eyebrow {
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    color: var(--faint);
    margin: 0 0 1.25rem;
    text-align: right;
  }
  .topics-eyebrow .accent { color: var(--accent); font-style: normal; }
  .topics-statement {
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.6vw, 1.9rem);
    line-height: 1.45;
    color: var(--heading);
    margin: 0 0 1rem;
  }
  .topics-statement .accent { color: var(--accent); font-style: normal; }
  .topics-statement-rule {
    border: 0;
    border-top: 2px solid var(--accent);
    margin: 0 0 3rem;
  }
  .topics-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 3rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem 4rem;
  }
  .topics-grid li {
    border-top: 1px solid var(--rule);
    padding-top: 1.25rem;
  }
  .topics-grid .topic-num {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--accent);
    display: block;
    margin-bottom: 1rem;
  }
  .topics-grid .topic-name {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--heading);
    margin: 0 0 0.6rem;
  }
  .topics-grid .topic-desc { color: var(--muted); margin: 0; font-size: 1rem; max-width: 30rem; }

  /* Publication note */
  .pub-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 3rem;
  }
  .pub-note .pub-meta {
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    color: var(--faint);
    line-height: 1.9;
  }
  .pub-note .pub-meta .accent { color: var(--accent); font-style: normal; }
  .pub-note h2 {
    font-size: clamp(2.4rem, 5vw, 4rem);
    margin: 0 0 1rem;
    max-width: 16ch;
  }
  .pub-note .lede { font-size: 1.15rem; max-width: 34rem; }

  .launch-note { margin-top: 1.75rem; border-top: 1px solid var(--rule); max-width: 44rem; }
  .launch-note summary {
    list-style: none;
    cursor: pointer;
    padding: 1rem 0;
    font-weight: 600;
    color: var(--heading);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .launch-note summary::-webkit-details-marker { display: none; }
  .launch-note summary .plus { color: var(--accent); font-weight: 700; }
  .launch-note summary:hover { color: var(--accent); }
  .launch-note .launch-body { padding: 0 0 1.5rem; color: var(--ink); }
  .launch-note .launch-body p { margin: 0 0 1rem; }
  .launch-note .launch-body p:first-child::first-letter {
    font-family: var(--serif);
    font-size: 3.1em;
    float: left;
    line-height: 0.88;
    padding-right: 0.12em;
    color: var(--heading);
  }

  /* Closing */
  .closing-block { margin: 5rem 0 0; }
  .closing-block .closing-lines {
    font-family: var(--serif);
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1.3;
    color: var(--heading);
    margin: 0 0 2rem;
  }
  .closing-block .closing-lines p { margin: 0; }
  .closing-block .closing-lines em { color: var(--accent); }
  .closing-block .editions-note {
    text-align: right;
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0;
  }

  @media (max-width: 860px) {
    .page { padding: 0 1.25rem 3rem; }
    .site-nav { margin: 0 -1.25rem; padding: 0.85rem 1.25rem; }
    .site-nav nav { display: none; }
    .hero { grid-template-columns: 1fr; gap: 1.5rem; }
    .teaser-row { grid-template-columns: 1fr; gap: 0.75rem; }
    .teaser-row .teaser-meta { text-align: left; }
    .bio, .note-grid, .pub-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .bio img { width: 160px; height: 190px; }
    .topics-grid { grid-template-columns: 1fr; }
    .topics-eyebrow { text-align: left; }
  }
</style>
