---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Preethi Ravula — notes on AI, models, and making thinking run." } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <main class="page">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Helvetica, Arial, sans-serif;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
    --ink: #45423c;
    --heading: #1e1c19;
    --muted: #6e6a61;
    --faint: #8d867c;
    --paper: #f7f4ed;
    --wash: #f1ece1;
    --rule: #ddd8cc;
    --accent: #c04a24;
    --accent-soft: #f7e4d8;
  }

  * { box-sizing: border-box; }

  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .page {
    max-width: 42rem;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
  }

  h1, h2, h3 {
    font-family: var(--serif);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--heading);
  }

  section { margin: 3.5rem 0; }

  a { color: var(--accent); }

  /* Sticky in-page nav */
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    margin: 0 -1.5rem;
    padding: 0.85rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
  }
  .site-nav .nav-brand { color: var(--ink); white-space: nowrap; }
  .site-nav .nav-brand .sep { color: var(--faint); }
  .site-nav nav { display: flex; gap: 1rem; }
  .site-nav nav a {
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .site-nav nav a:hover { color: var(--accent); }
  .site-nav .nav-label { color: var(--faint); }

  .kicker {
    font-family: var(--mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--faint);
    margin: 0 0 0.75rem;
  }
  .kicker .accent { color: var(--accent); font-style: normal; }

  .hero { padding-top: 4.5rem; }
  .hero h1 {
    font-size: clamp(2.6rem, 6vw, 3.6rem);
    margin: 0 0 1rem;
  }
  .hero h1 em { color: var(--accent); }
  .hero p { margin: 0 0 1.1rem; max-width: 36rem; }
  .hero p:last-child { margin-bottom: 0; }

  .divider {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 0;
  }

  .teaser-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 1.5rem 0 1.5rem 1.25rem;
    border-left: 3px solid var(--accent);
  }
  .teaser-card .teaser-label {
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }
  .teaser-card h3 {
    font-size: 1.5rem;
    margin: 0 0 0.35rem;
  }
  .teaser-card .teaser-sub {
    color: var(--muted);
    font-size: 1rem;
    margin: 0 0 0.6rem;
  }
  .teaser-card .teaser-meta {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--faint);
    margin: 0;
  }

  .bio {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }
  .bio img {
    width: 120px;
    height: 140px;
    border-radius: 12px;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--rule);
  }
  .bio h2 { font-size: 1.75rem; margin: 0 0 0.25rem; }
  .bio .bio-loc {
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin: 0 0 0.75rem;
  }
  .bio p { margin: 0 0 0.75rem; }
  .bio p:last-child { margin-bottom: 0; }
  .bio .ext-link { text-decoration: none; font-weight: 600; }
  .bio .ext-link:hover { text-decoration: underline; }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .section-head h2 { margin: 0; font-size: clamp(1.8rem, 4vw, 2.3rem); }
  .section-head .index-tag {
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--accent);
    white-space: nowrap;
  }

  .coming-soon {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    margin-bottom: 1rem;
  }
  .tag-label {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0 0 0.5rem;
  }

  .post-title { font-size: clamp(2rem, 4.5vw, 2.6rem); margin: 0 0 0.5rem; }
  .post-subtitle {
    font-family: var(--serif);
    font-style: italic;
    color: var(--muted);
    font-size: 1.2rem;
    margin: 0 0 1.75rem;
  }
  .post-body p { margin: 0 0 1.25rem; }

  .closing-callout {
    border-left: 3px solid var(--accent);
    padding: 0.25rem 0 0.25rem 1.25rem;
    margin: 2.5rem 0 0;
  }
  .closing-callout p {
    font-family: var(--serif);
    font-size: 1.35rem;
    margin: 0;
    color: var(--heading);
  }

  .method-kicker {
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    color: var(--faint);
    margin: 0 0 0.75rem;
  }
  .method-lines h2 {
    font-size: clamp(1.8rem, 4vw, 2.3rem);
    margin: 0 0 0.75rem;
  }
  .method-lines .method-sub { color: var(--muted); margin: 0; }

  .topics-eyebrow {
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--faint);
    margin: 0 0 0.75rem;
  }
  .topics-eyebrow .accent { color: var(--accent); font-style: normal; }
  .topics-head {
    font-size: clamp(1.8rem, 4vw, 2.3rem);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 1.25rem;
  }
  .topics-intro p { margin: 0 0 1rem; }
  .topics-intro .lead { font-weight: 600; color: var(--heading); }

  .topics { list-style: none; padding: 0; margin: 2rem 0 0; }
  .topics li {
    border-top: 1px solid var(--rule);
    padding: 1.25rem 0;
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
  }
  .topics li:last-child { border-bottom: 1px solid var(--rule); }
  .topics .topic-num {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--accent);
    padding-top: 0.2rem;
  }
  .topics .topic-name {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--heading);
    margin: 0 0 0.3rem;
  }
  .topics .topic-name .field-tag {
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    margin-left: 0.6rem;
    vertical-align: middle;
    white-space: nowrap;
  }
  .topics .topic-desc { color: var(--muted); margin: 0; font-size: 1rem; }

  .pub-note .pub-meta {
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    color: var(--faint);
    margin: 0 0 1.5rem;
  }
  .pub-note .pub-meta .accent { color: var(--accent); font-style: normal; }
  .pub-note .pub-meta div { margin-bottom: 0.25rem; }
  .pub-note h2 {
    font-size: clamp(2.2rem, 5vw, 3rem);
    margin: 0 0 1rem;
    max-width: 20ch;
  }
  .pub-note .lede { font-size: 1.15rem; max-width: 34rem; }

  .launch-note { margin-top: 1.75rem; border-top: 1px solid var(--rule); }
  .launch-note summary {
    list-style: none;
    cursor: pointer;
    padding: 1rem 0;
    font-weight: 600;
    color: var(--heading);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .launch-note summary::-webkit-details-marker { display: none; }
  .launch-note summary .plus { color: var(--accent); font-weight: 700; }
  .launch-note summary:hover { color: var(--accent); }
  .launch-note .launch-body { padding: 0 0 1.5rem; color: var(--ink); }
  .launch-note .launch-body p { margin: 0 0 1rem; }
  .launch-note .launch-body p:first-child::first-letter {
    font-family: var(--serif);
    font-size: 3.1em;
    float: left;
    line-height: 0.88;
    padding-right: 0.12em;
    color: var(--heading);
  }

  .closing-block { margin: 4rem 0 0; }
  .closing-block .closing-lines {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    line-height: 1.4;
    color: var(--heading);
    margin: 0 0 1.5rem;
  }
  .closing-block .closing-lines p { margin: 0; }
  .closing-block .closing-lines em { color: var(--accent); }
  .closing-block .editions-note {
    text-align: right;
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--accent);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .back-link:hover { text-decoration: underline; }

  @media (max-width: 640px) {
    .site-nav nav { display: none; }
    .bio img { width: 96px; height: 112px; }
    .topics li { grid-template-columns: 2.25rem 1fr; }
  }
</style>
