---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Preethi Ravula — notes on AI, models, and making thinking run." } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <main class="page">
      <slot />
    </main>
    <footer class="footer">
      <p>Preethi Ravula · {new Date().getFullYear()}</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Helvetica, Arial, sans-serif;
    --ink: #2b2620;
    --muted: #6f655a;
    --faint: #8d8378;
    --paper: #faf7f1;
    --wash: #f3eee3;
    --rule: #e3dccb;
    --accent: #b4552d;
    --accent-soft: #f6e3d4;
  }

  * { box-sizing: border-box; }

  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .page {
    max-width: 42rem;
    margin: 0 auto;
    padding: 4.5rem 1.5rem 3rem;
  }

  h1, h2, h3 {
    font-family: var(--serif);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  section { margin: 3.5rem 0; }

  .eyebrow {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--faint);
    margin: 0 0 0.75rem;
  }

  .hero h1 {
    font-size: clamp(2.6rem, 6vw, 3.6rem);
    margin: 0 0 1rem;
  }

  .hero .standfirst {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-style: italic;
    color: var(--muted);
    margin: 0 0 2.5rem;
    max-width: 34rem;
  }

  .divider {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 0;
  }

  .teaser-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 1.5rem 1.75rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }
  .teaser-card:hover {
    border-color: var(--accent);
    box-shadow: 0 8px 28px rgba(180, 85, 45, 0.12);
    transform: translateY(-2px);
  }
  .teaser-card .teaser-label {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }
  .teaser-card h3 {
    font-size: 1.5rem;
    margin: 0 0 0.35rem;
  }
  .teaser-card .teaser-sub {
    color: var(--muted);
    font-size: 1rem;
    margin: 0;
  }

  .bio {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .bio img {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--rule);
  }
  .bio p { margin: 0 0 0.6rem; }
  .bio .bio-line { font-weight: 600; }
  .bio .bio-meta { color: var(--muted); font-size: 0.95rem; }
  .bio a { color: var(--accent); text-decoration-thickness: 1px; }

  .coming-soon {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    margin-bottom: 1rem;
  }

  .post-title { font-size: clamp(2rem, 4.5vw, 2.6rem); margin: 0 0 0.5rem; }
  .post-subtitle {
    font-family: var(--serif);
    font-style: italic;
    color: var(--muted);
    font-size: 1.2rem;
    margin: 0 0 1.75rem;
  }
  .post-body p { margin: 0 0 1.25rem; }

  .closing-callout {
    border-left: 3px solid var(--accent);
    padding: 0.25rem 0 0.25rem 1.25rem;
    margin: 2.5rem 0 0;
  }
  .closing-callout p {
    font-family: var(--serif);
    font-size: 1.35rem;
    margin: 0;
  }

  .method-lines p {
    font-family: var(--serif);
    font-size: 1.25rem;
    margin: 0 0 0.75rem;
  }
  .method-lines .method-sub {
    font-family: var(--sans);
    font-size: 1rem;
    color: var(--muted);
  }

  .bridge {
    font-family: var(--serif);
    font-size: 1.4rem;
    line-height: 1.5;
    padding: 1.25rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    margin: 1.75rem 0 2rem;
  }
  .bridge strong { color: var(--accent); font-weight: 700; }

  .topics { list-style: none; padding: 0; margin: 0; }
  .topics li { margin: 0 0 1.4rem; }
  .topics .topic-name {
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 600;
  }
  .topics .topic-desc { color: var(--muted); margin: 0.15rem 0 0; }
  .topics .field-notes { font-style: italic; }

  .closing-line {
    font-family: var(--serif);
    font-size: 1.3rem;
    text-align: center;
    margin: 4rem 0 1rem;
    color: var(--ink);
  }

  .footer {
    border-top: 1px solid var(--rule);
    padding: 1.5rem;
    text-align: center;
    color: var(--faint);
    font-size: 0.9rem;
  }
  .footer p { margin: 0; }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--accent);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .back-link:hover { text-decoration: underline; }

  @media (max-width: 560px) {
    .page { padding-top: 3rem; }
    section { margin: 2.75rem 0; }
    .bio img { width: 68px; height: 68px; }
  }
</style>
